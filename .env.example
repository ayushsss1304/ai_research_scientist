# =============================================================================
# AI Research Scientist - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual keys
# cp .env.example .env

# API Keys (FREE sources - get your own keys)
IEEE_API_KEY=your_ieee_api_key_here
ELSEVIER_API_KEY=your_elsevier_api_key_here
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
PUBMED_API_KEY=
CORE_API_KEY=your_core_api_key_here
SERPAPI_KEY=

# Cloud AI (OpenRouter's free router selects an available free model,
# including a vision-capable model when an image is supplied.)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it:free
APP_URL=http://localhost:5000

# Email for polite API access (OpenAlex, CrossRef)
USER_EMAIL=your.email@example.com

# Neo4j Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=

# Deployment/runtime settings
FLASK_SECRET_KEY=replace_with_a_long_random_value
ENABLE_KNOWLEDGE_GRAPH=true
# Leave false on Vercel unless OLLAMA_BASE_URL points to a hosted Ollama server.
ENABLE_RAG_CHATBOT=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
